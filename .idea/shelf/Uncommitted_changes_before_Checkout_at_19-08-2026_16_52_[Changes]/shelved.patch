+    private fun handleHttpError(code: Int, errorBody: String?, defaultMessage: String?) {
+
+        Log.e(
+            "API_ERROR",
+            "HTTP Code: $code | Error: $errorBody"
+        )
+
+        val serverMessage = getServerErrorMessage(errorBody)
+
+        val message = when (code) {
+
+            400 -> {
+                serverMessage
+                    ?: "Invalid request. Please check the entered details."
+            }
+
+            401 -> {
+                serverMessage
+                    ?: "Session expired. Please login again."
+            }
+
+            403 -> {
+                serverMessage
+                    ?: "You are not authorized to perform this action."
+            }
+
+            404 -> {
+                serverMessage
+                    ?: "Requested service or data was not found."
+            }
+
+            405 -> {
+                serverMessage
+                    ?: "This operation is not allowed."
+            }
+
+            408 -> {
+                serverMessage
+                    ?: "Request timed out. Please try again."
+            }
+
+            409 -> {
+                serverMessage
+                    ?: "Request conflicts with existing data."
+            }
+
+            422 -> {
+                serverMessage
+                    ?: "Invalid data. Please verify the entered information."
+            }
+
+            429 -> {
+                serverMessage
+                    ?: "Too many requests. Please wait and try again."
+            }
+
+            500 -> {
+                serverMessage
+                    ?: "Internal server error. Please try again later."
+            }
+
+            501 -> {
+                serverMessage
+                    ?: "This operation is not supported by the server."
+            }
+
+            502 -> {
+                serverMessage
+                    ?: "Bad gateway. Please try again later."
+            }
+
+            503 -> {
+                serverMessage
+                    ?: "Service is temporarily unavailable. Please try again later."
+            }
+
+            504 -> {
+                serverMessage
+                    ?: "Server request timed out. Please try again."
+            }
+
+            else -> {
+                serverMessage
+                    ?: defaultMessage
+                    ?: "Something went wrong. Please try again."
+            }
+        }
+
+        showErrorToast(message)
+    }
+
+    private fun getServerErrorMessage(errorBody: String?): String? {
+
+        if (errorBody.isNullOrBlank()) {
+            return null
+        }
+
+        return try {
+
+            val jsonObject = JSONObject(errorBody)
+
+            when {
+                jsonObject.has("message") ->
+                    jsonObject.optString("message")
+
+                jsonObject.has("Message") ->
+                    jsonObject.optString("Message")
+
+                jsonObject.has("error") ->
+                    jsonObject.optString("error")
+
+                else -> null
+            }
+
+        } catch (e: Exception) {
+
+            Log.e(
+                "API_ERROR",
+                "Error parsing error response",
+                e
+            )
+
+            null
+        }
+    }
